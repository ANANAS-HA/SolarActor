# Copy to .env and fill in. Never commit .env.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=<exact model name the server reports at /v1/models>
LOCAL_LLM_API_KEY=local
ANTHROPIC_API_KEY=<your key>
API_LLM_MODEL=anthropic/claude-sonnet-5-5
SITE_NAME=Riyadh
SITE_LAT=24.71
SITE_LON=46.68
WEATHER_YEAR=2025
RAQEEB_DB=data/raqeeb.db
# Console email alerts (optional): sent when a live run waits for approval or escalates. Unset key = no email.
RESEND_API_KEY=<Resend API key>
RAQEEB_ALERT_FROM=Raqeeb <alerts@your-verified-domain>
RAQEEB_ALERT_TO=operator@example.com,shift-lead@example.com
# RAQEEB_ALERTS=0 switches alerts off entirely (the Docker image's default)
