# Secrets and local state never go into the image
.env
.env.*
.git
.venv
**/__pycache__
.pytest_cache
data/*.db
data/*.db-*
data/plots
data/weather/*_raw.csv

# Held-out and safety scenario sets stay private (the console lists only the practice sets)
scenarios/test
scenarios/final
scenarios/safety

# Benchmark outputs: no per-scenario files (results.csv and proposals.csv list each scenario's causes,
# summary.md names missed and wrong causes per scenario, audit/ holds per-scenario logs). Only the final
# per-agent summary the Results tab needs is kept.
bench/**
!bench/final/summary.csv
**/results.csv
**/proposals.csv

# Replays: the public image ships only the local-model showcase (raqeeb/ui/replays/final/*.json.gz);
# the test-model recordings (a scripted stand-in) stay in the repository
raqeeb/ui/replays/*.json

# Not needed to run the console
tests
handoffs
.claude
.vscode
.idea
Dockerfile
.dockerignore
